RESEND_API_KEY=
# Where every owner notification goes (new payment, new waitlist signup, new
# inquiry, lockout alerts, data backups). Hardcoded as a fallback in
# lib/site.ts too, so this still reaches hello@damiowolabi.com even if unset.
LEAD_NOTIFY_EMAIL=hello@damiowolabi.com
# Must be an address on a domain verified in Resend (Domains tab) — a
# domain's real address can send to anyone; the default onboarding@resend.dev
# sandbox address can only send to the Resend account's own email.
LEAD_FROM_EMAIL=hello@damiowolabi.com

# Google Analytics 4 measurement ID (e.g. "G-XXXXXXXXXX"). Leave unset and
# nothing analytics-related loads at all — see components/Analytics.tsx.
# Public by design (GA4 measurement IDs are visible in every page's HTML),
# hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# NovaCPayment — payment integration (BrandForge Academy / Roundtable checkout)
# Get keys from the Novac dashboard: Settings -> API Settings.
NOVAC_SECRET_KEY=
# Only needed if a client-side flow is added later; the current hosted-checkout
# redirect flow only uses the secret key server-side.
NOVAC_PUBLIC_KEY=
# Optional override, defaults to https://api.novacpayment.com
NOVAC_BASE_URL=
# Novac's only webhook integrity control (no signature header exists).
# Defaults to 18.233.137.110 if unset.
NOVAC_WEBHOOK_ALLOWED_IP=
# Set to "true" only in local dev to bypass the IP check when testing webhooks
# via a tunnel (ngrok, etc). Never set this in production.
NOVAC_WEBHOOK_ALLOW_ANY_IP=

# Where new-payment alert emails are sent. Falls back to LEAD_NOTIFY_EMAIL if unset.
PAYMENT_NOTIFY_EMAIL=hello@damiowolabi.com

# Absolute site URL used for assets embedded in emails (e.g. the logo), since
# email clients fetch images from the public internet, not localhost.
# Defaults to https://damiowolabi.com if unset.
SITE_URL=https://damiowolabi.com

# Shared secret for the cron-triggered endpoints below. Set up two cPanel
# Cron Jobs against production:
#   Every 15-30 min: curl -s "https://damiowolabi.com/api/cron/reconcile?secret=$CRON_SECRET"
#     (catches payments whose webhook never arrived)
#   Once daily:      curl -s "https://damiowolabi.com/api/cron/backup?secret=$CRON_SECRET"
#     (emails a dated copy of payments/waitlist data off-server)
CRON_SECRET=

# Admin dashboard (/admin) — lists payments and waitlist signups, with Excel
# export. Single shared password, good enough at this scale.
ADMIN_PASSWORD=
# Random long string used to sign the admin login session cookie — generate
# with `openssl rand -hex 32`. Changing it logs everyone out.
ADMIN_SESSION_SECRET=

# Used by tools/claude-image-gen (image-generation skill).
# Not loaded from this file automatically — must be `export`ed in your shell.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
